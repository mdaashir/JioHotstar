{
  "name": "jiohotstar-desktop",
  "version": "0.1.8",
  "private": true,
  "description": "Unofficial desktop app for JioHotstar on Windows, macOS and Linux, built as an Electron shell around the official web player with Widevine DRM.",
  "keywords": [
    "jiohotstar",
    "hotstar",
    "desktop-app",
    "electron",
    "electron-app",
    "electron-builder",
    "widevine",
    "drm",
    "castlabs",
    "streaming",
    "video-player",
    "picture-in-picture",
    "media-keys",
    "macos",
    "windows",
    "linux",
    "typescript",
    "react"
  ],
  "author": "mdaashir",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdaashir/JioHotstar.git"
  },
  "homepage": "https://github.com/mdaashir/JioHotstar#readme",
  "bugs": {
    "url": "https://github.com/mdaashir/JioHotstar/issues"
  },
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "package": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:mac:arm64": "npm run build && electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "npm run build && electron-builder --mac --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "electron-store": "8.2.0",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "https://github.com/castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
